# Rust build output
/target/
/target-*/

/output/

# Keep exactly one verified Windows bundle in the repository so GitHub's
# generated source ZIP can be launched without a compiler. Everything else
# under dist remains local build output. CI verifies this allowlist, the
# manifest hashes, the binary version, and runtime-source freshness.
/dist/*
!/dist/BaseSearch/
/dist/BaseSearch/*
!/dist/BaseSearch/BaseSearch.exe
!/dist/BaseSearch/base-search-cli.exe
!/dist/BaseSearch/Open Base Search.cmd
!/dist/BaseSearch/README.txt
!/dist/BaseSearch/LICENSE
!/dist/BaseSearch/release-manifest.json
/release_packages/

# Local application data and SQLite sidecar files
/data/
*.db
*.sqlite
*.sqlite3
*.duckdb
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Source datasets and generated exports
*.xlsx
*.xls
*.xlsb
*.csv

# Local configuration, logs, and temporary files
.env
.env.*
*.log
*.tmp
*.temp

# Public documentation policy
*.md
!README.md
!README.uk.md
!LICENSE*.md

# Local planning drafts and internal audits
/docs/
/audit/

# Browser workspace frontend: dependencies and build output are produced
# locally by `npm install` / `npm run build`; the compiled assets are embedded
# into the Rust binary at release build time.
/web-ui/node_modules/
/web-ui/dist/
/web-ui/test-results/
/web-ui/playwright-report/

# Editor and OS files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Leftovers of the one-time move of the 2.0.x tree into the repository root.
# Only build output and node_modules remain there; they are locked by a running
# process and can be deleted once it exits.
/BaseSearch-master/
