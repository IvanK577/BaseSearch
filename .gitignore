# Rust build output
/target/
/target-*/

/output/

# Packaged application builds. Binaries are NOT committed: a checked-in
# executable goes stale silently, and the one that used to live here stayed at
# 2.0 while the source moved on, so the documented quick start handed people an
# old build under a new version number. Releases and scripts/package-release.ps1
# are the only ways a binary should reach anyone.
/dist/
/release_packages/

# Local application data and SQLite sidecar files
/data/
*.db
*.sqlite
*.sqlite3
*.duckdb
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Source datasets and generated exports
*.xlsx
*.xls
*.xlsb
*.csv

# Local configuration, logs, and temporary files
.env
.env.*
*.log
*.tmp
*.temp

# Public documentation policy
*.md
!README.md
!LICENSE*.md

# Local planning drafts and internal audits
/docs/
/audit/

# Browser workspace frontend: dependencies and build output are produced
# locally by `npm install` / `npm run build`; the compiled assets are embedded
# into the Rust binary at release build time.
/web-ui/node_modules/
/web-ui/dist/
/web-ui/test-results/
/web-ui/playwright-report/

# Editor and OS files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Leftovers of the one-time move of the 2.0.x tree into the repository root.
# Only build output and node_modules remain there; they are locked by a running
# process and can be deleted once it exits.
/BaseSearch-master/
