{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Base Search",
  "version": "1.0.0",
  "identifier": "io.github.ivank577.basesearch.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix app-ui run dev",
    "beforeBuildCommand": "npm --prefix app-ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../app-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Base Search",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb"],
    "category": "Productivity",
    "shortDescription": "Local search over spreadsheet data",
    "longDescription": "Import, search, summarize and export spreadsheet records in a local workspace.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
